{
  "version": 1,
  "purpose": "RESX hosted PRE immutable Git-tree build context",
  "source": "Exact reviewed commit SHA, supplied by Deploy; never the worktree",
  "include": [
    "package.json",
    "yarn.lock",
    "api/package.json",
    "api/tsconfig.json",
    "api/src/**/*.ts",
    "api/src/templates/mail/*.txt",
    "webapp/package.json",
    "webapp/angular.json",
    "webapp/tsconfig.json",
    "webapp/.browserslistrc",
    "webapp/src/**/*.ts",
    "webapp/src/**/*.html",
    "webapp/src/**/*.css",
    "webapp/src/**/*.scss",
    "webapp/src/**/*.png",
    "webapp/src/**/*.ico",
    "webapp/src/tsconfig.app.json",
    "webapp/src/tsconfig.spec.json",
    "webapp/src/tslint.json",
    "docs-website/package.json",
    "bin/resx-phase1-profile.cjs",
    "bin/resx-runtime-profile.cjs",
    "bin/resx-runtime.cjs",
    "deploy/resx/Dockerfile",
    "deploy/resx/Dockerfile.dockerignore",
    "deploy/resx/build-inputs.json",
    "webapp/src/assets/.gitkeep",
    "webapp/src/assets/fonts/material-icons/MaterialIcons-Regular.ttf",
    "webapp/src/assets/fonts/material-icons/LICENSE.txt",
    "webapp/src/assets/fonts/material-icons/README.md"
  ],
  "exclude": [
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/node_modules/**",
    "**/.env",
    "**/.env.*",
    "**/*.env",
    "**/*.pem",
    "**/*.key",
    "**/*.crt",
    "**/*.cer",
    "**/*.der",
    "**/*.p12",
    "**/*.pfx",
    "**/*.jks",
    "**/*.keystore",
    "**/*.zip",
    "**/*.tar",
    "**/*.gz",
    "**/*.tgz",
    "**/*.7z",
    "**/*.rar",
    "**/*.sql",
    "**/*.dump",
    "**/*.bak",
    "**/*.db",
    "**/*.sqlite*",
    "api/data/**"
  ],
  "materialization": "Regular blobs from the selected Git tree only; reject symlinks/submodules and path traversal; exclude overrides include. Apply Dockerfile-specific ignore too.",
  "receipts": [
    "source SHA",
    "manifest SHA256",
    "base image digest",
    "context inventory/hash",
    "built image digest",
    "Linux/native dependency and startup health qualification"
  ],
  "baseImage": "docker.io/library/node@sha256:47725aca53d3295ec2d3be8f62726599b3033cc262edc2c7e429909b3ac599fc",
  "platform": "linux/amd64"
}
